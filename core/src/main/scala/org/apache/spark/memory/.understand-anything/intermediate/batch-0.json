    },
    {
      "id": "class:core/src/main/scala/org/apache/spark/memory/ExecutionMemoryPool.scala:ExecutionMemoryPool",
      "type": "class",
      "name": "ExecutionMemoryPool",
      "filePath": "core/src/main/scala/org/apache/spark/memory/ExecutionMemoryPool.scala",
      "complexity": "moderate",
      "summary": "执行内存池。继承 MemoryPool 并混入 Logging，维护 memoryForTask 映射实现按任务维度的内存跟踪和公平共享。acquireMemory 在内存不足时阻塞，直到每个任务至少能获得 1/(2N) 的内存。",
      "tags": ["concrete-class", "private[memory]", "task-tracking", "fairness"]
    },
