      "tags": ["abstract-class", "private[spark]", "jvm-wide", "tungsten", "composite"]
    },
    {
      "id": "class:core/src/main/scala/org/apache/spark/memory/UnifiedMemoryManager.scala:UnifiedMemoryManager",
      "type": "class",
      "name": "UnifiedMemoryManager",
      "filePath": "core/src/main/scala/org/apache/spark/memory/UnifiedMemoryManager.scala",
      "complexity": "complex",
      "summary": "MemoryManager 的具体实现。强制执行和存储之间的软边界：执行内存不足时可驱逐存储缓存以回收空间；存储空间不足时可借用执行空闲内存。",
      "tags": ["concrete-class", "private[spark]", "unified-memory", "soft-boundary"]
    },
    {
      "id": "class:core/src/main/scala/org/apache/spark/memory/UnifiedMemoryManager.scala:UnifiedMemoryManager$",
